{
  "name": "moviematch",
  "version": "2.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "run-p lint:*",
    "lint:types": "tsc --noEmit",
    "lint:css": "stylelint '**/*.css'",
    "lint:style": "prettier --ignore-path .gitignore  '**/*.{ts,js,css,json}' --check",
    "format": "prettier --ignore-path .gitignore  '**/*.{ts,js,css,json}' -w",
    "build-docker": "docker build -t moviematch:local .",
    "start-docker": "docker compose up"
  },
  "keywords": [],
  "author": "Luke Channings",
  "license": "LICENSE",
  "prettier": {
    "semi": false,
    "arrowParens": "avoid",
    "singleQuote": true
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "ignoreFiles": [
      "public/index.html"
    ],
    "rules": {
      "media-feature-range-notation": "prefix"
    }
  },
  "dependencies": {
    "ws": "^8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8",
    "npm-run-all2": "^6.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5"
  }
}
