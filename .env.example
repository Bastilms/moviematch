# MovieMatch configuration example
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then update the configuration below with your media server details.

# Backend selection
BACKEND=plex

# Plex server configuration
# Only required when BACKEND=plex
PLEX_URL=https://plex.example.com:32400
PLEX_TOKEN=

# Jellyfin server configuration
# Only required when BACKEND=jellyfin
# JELLYFIN_URL=https://jellyfin.example.com
# JELLYFIN_API_KEY=
# JELLYFIN_USER_ID=

# Database configuration
# For local development: ./data/moviematch.db
# For Docker: /data/moviematch.db (do not override the Dockerfile ENV)
# DATABASE_PATH=./data/moviematch.db

# Server configuration
PORT=8000
ROOT_PATH=

# Library and content filtering
# LIBRARY_FILTER filters by library name (comma-separated list of library names to include)
# When using Jellyfin, this filters by the library/view name
# LIBRARY_FILTER=Films,Television

# COLLECTION_FILTER filters by collection name (comma-separated list)
# When using Jellyfin, this filters by BoxSet names
# COLLECTION_FILTER=Marvel,HBO

# DEFAULT_SECTION_TYPE_FILTER specifies the default library type
# Plex values: movie, show, artist, photo
# Jellyfin mapping: movie → movies, show → tvshows, artist → music, photo → homevideos
DEFAULT_SECTION_TYPE_FILTER=movie

# Link type for opening matches (Plex only; Jellyfin always uses web UI)
# Supported values: app, http, plex.tv
LINK_TYPE=app

# Logging
LOG_LEVEL=INFO

# Movie batch loading
MOVIE_BATCH_SIZE=25

# Rate limiting configuration
# RATE_LIMIT_ENABLED: Enable rate limiting (true/false)
# RATE_LIMIT_HTTP_PER_MINUTE: HTTP requests per IP per minute
# RATE_LIMIT_WS_PER_MINUTE: WebSocket connection attempts per IP per minute
# RATE_LIMIT_MESSAGES_PER_MINUTE: WebSocket messages per IP per minute
# RATE_LIMIT_LOGIN_PER_MINUTE: Jellyfin sign-in attempts per IP per minute
# Requests exceeding the limits will not receive a response and will time out.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_HTTP_PER_MINUTE=300
RATE_LIMIT_WS_PER_MINUTE=20
RATE_LIMIT_MESSAGES_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10

# SESSION_TTL_HOURS: How long a Jellyfin sign-in is kept in server memory, in hours.
# When the time is up the session is discarded and its access token is
# invalidated at the Jellyfin server.
SESSION_TTL_HOURS=12

# Trust X-Forwarded-For header for client IP (only enable if behind a reverse proxy)
# WARNING: Only set to true if MovieMatch is behind a trusted reverse proxy (nginx, HAProxy, etc.).
# If true without a proxy, clients can spoof X-Forwarded-For to bypass rate limits.
TRUST_PROXY=false
