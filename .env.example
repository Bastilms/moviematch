# MovieMatch configuration example
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then update the configuration below with your media server details.

# Backend selection
BACKEND=plex

# Plex server configuration
# Only required when BACKEND=plex
PLEX_URL=https://plex.example.com:32400
PLEX_TOKEN=

# Jellyfin server configuration
# Only required when BACKEND=jellyfin
# JELLYFIN_URL=https://jellyfin.example.com
# JELLYFIN_API_KEY=
# JELLYFIN_USER_ID=

# Database configuration
# For local development: ./data/moviematch.db
# For Docker: /data/moviematch.db (do not override the Dockerfile ENV)
# DATABASE_PATH=./data/moviematch.db

# Server configuration
PORT=8000
ROOT_PATH=

# Library and content filtering
# LIBRARY_FILTER filters by library name (comma-separated list of library names to include)
# When using Jellyfin, this filters by the library/view name
# LIBRARY_FILTER=Films,Television

# COLLECTION_FILTER filters by collection name (comma-separated list)
# When using Jellyfin, this filters by BoxSet names
# COLLECTION_FILTER=Marvel,HBO

# DEFAULT_SECTION_TYPE_FILTER specifies the default library type
# Plex values: movie, show, artist, photo
# Jellyfin mapping: movie → movies, show → tvshows, artist → music, photo → homevideos
DEFAULT_SECTION_TYPE_FILTER=movie

# Link type for opening matches (Plex only; Jellyfin always uses web UI)
# Supported values: app, http, plex.tv
LINK_TYPE=app

# Logging
LOG_LEVEL=INFO

# Movie batch loading
MOVIE_BATCH_SIZE=25
